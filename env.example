# Hugging Face token (gated models / Inference Endpoints)
HF_TOKEN=your_token_here

# N-ATLaS Inference Endpoint (optional — leave empty for local transformers)
NATLAS_ENDPOINT_URL=

# Local model performance tuning
N_THREADS=6          # CPU threads for generation (default: auto-detect)
N_GPU_LAYERS=0       # GPU offload layers for transformers (0 = CPU / auto)
N_CTX=3072           # Context window size
